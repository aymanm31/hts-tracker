# Neon Postgres connection strings
# Get these from your own Neon project: https://console.neon.tech
# Direct connection - use for schema migrations (Alembic, etc.)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Pooled connection - use for normal app reads/writes (fetch, save, diff scripts)
DATABASE_URL_POOLED=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require&channel_binding=require